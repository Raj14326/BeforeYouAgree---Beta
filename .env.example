# Server-only secrets and settings. Copy this file to .env for local development.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Comma-separated frontend origins allowed to call the API in production.
ALLOWED_ORIGINS=http://localhost:5173

# Optional server/model overrides.
HOST=0.0.0.0
PORT=8787
BERT_MODEL_DIR=ml/local-models/bya-legalbert-small-unfair-tos
