FROM node:24-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080 \
    BERT_BATCH_SIZE=4

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server ./server
COPY ml/local-models/bya-legalbert-small-unfair-tos ./ml/local-models/bya-legalbert-small-unfair-tos

EXPOSE 8080
CMD ["npm", "run", "server"]
